{
    "name": "Novarr",
    "short_name": "Novarr",
    "description": "Web novel manager and reader",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#12151B",
    "theme_color": "#0F1216",
    "orientation": "any",
    "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        {
            "name": "Continue Reading",
            "short_name": "Continue",
            "description": "Resume the chapter you were reading",
            "url": "/continue",
            "icons": [{ "src": "/shortcut-continue.png", "sizes": "96x96", "type": "image/png" }]
        },
        {
            "name": "Discover",
            "short_name": "Discover",
            "description": "Find and add a novel",
            "url": "/novels/discover",
            "icons": [{ "src": "/shortcut-discover.png", "sizes": "96x96", "type": "image/png" }]
        },
        {
            "name": "Downloads",
            "short_name": "Downloads",
            "description": "Novels saved on this device for offline reading",
            "url": "/library",
            "icons": [{ "src": "/shortcut-downloads.png", "sizes": "96x96", "type": "image/png" }]
        },
        {
            "name": "Reading Stats",
            "short_name": "Stats",
            "description": "Streaks and chapters read per day",
            "url": "/stats",
            "icons": [{ "src": "/shortcut-stats.png", "sizes": "96x96", "type": "image/png" }]
        }
    ]
}
