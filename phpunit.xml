<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>

        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <!-- The whole suite peaks just under PHP's default 128M; headroom so
             a few more tests don't end the run in a fatal error. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_TIMEZONE" value="UTC"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="NOVARR_MANGA_PAGE_DELAY_MS" value="0"/>
        <env name="NOVARR_MANGADEX_REQUEST_DELAY_MS" value="0"/>
        <env name="NOVARR_NOVELFIRE_REQUEST_DELAY_MS" value="0"/>
        <env name="NOVARR_NOVELFIRE_RATE_LIMIT_WAIT_MS" value="0"/>
        <env name="NOVARR_SUWAYOMI_URL" value=""/>
        <!-- No test reaches Have I Been Pwned or Cloudflare: the breach check is
             off unless a test turns it on (with Http::fake). -->
        <env name="NOVARR_PASSWORD_BREACH_CHECK" value="off"/>
    </php>
</phpunit>
