#=============================================================================
# NOVARR - Docker Environment Configuration
#=============================================================================
# Copy this file to .env and update the values as needed.
# Required variables are marked with [REQUIRED]
# Optional variables have sensible defaults for Docker deployment
#=============================================================================

#-----------------------------------------------------------------------------
# Application Settings
#-----------------------------------------------------------------------------
APP_NAME=Novarr
APP_ENV=production
# [REQUIRED] Generate with: php artisan key:generate (Docker: docker compose run --rm app php artisan key:generate --show)
APP_KEY=
APP_DEBUG=false
# [REQUIRED] Set to your public URL (e.g., https://novarr.example.com)
APP_URL=http://localhost
# Timezone for the application (e.g., America/New_York, Europe/London, Asia/Tokyo)
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode configuration
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

#-----------------------------------------------------------------------------
# Database Configuration
#-----------------------------------------------------------------------------
DB_CONNECTION=mysql
# Use 'mysql' to match the docker-compose service name
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=novarr
DB_USERNAME=novarr_user
# [REQUIRED] Set a strong password for the database user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# [REQUIRED] Set a strong password for MySQL root user
DB_ROOT_PASSWORD=

# Optional: Use a database URL instead of individual settings
# DB_URL=

#-----------------------------------------------------------------------------
# Redis Configuration
#-----------------------------------------------------------------------------
# Use 'redis' to match the docker-compose service name
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

#-----------------------------------------------------------------------------
# Cache & Session Configuration
#-----------------------------------------------------------------------------
# Using Redis for cache and sessions in Docker for better performance
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

#-----------------------------------------------------------------------------
# Queue Configuration
#-----------------------------------------------------------------------------
# Background commands from the web UI are queued; the scheduler drains the
# queue every minute (queue:work --stop-when-empty), so 'database' works with
# no extra worker process. 'sqs' requires aws/aws-sdk-php which is NOT installed.
QUEUE_CONNECTION=database
# Where to store failed job records
QUEUE_FAILED_DRIVER=database-uuids
# Seconds before a reserved job is considered stuck and handed out again.
# Must be longer than the longest job timeout (UI-triggered scrapes run up
# to 3600s), otherwise long scrapes get double-run and reported as failed.
DB_QUEUE_RETRY_AFTER=3700
REDIS_QUEUE_RETRY_AFTER=3700

# AWS SQS Configuration (uncomment if using SQS instead of Redis)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# SQS_PREFIX=
# SQS_QUEUE=default

#-----------------------------------------------------------------------------
# Laravel Octane Configuration
#-----------------------------------------------------------------------------
OCTANE_SERVER=roadrunner
OCTANE_HTTPS=false
# Number of workers (adjust based on your server's CPU cores)
# OCTANE_WORKERS=auto
# Maximum requests before worker restart (helps with memory leaks)
# OCTANE_MAX_REQUESTS=500

#-----------------------------------------------------------------------------
# Filesystem Configuration
#-----------------------------------------------------------------------------
FILESYSTEM_DISK=local

#-----------------------------------------------------------------------------
# Backups (php artisan backup:run, scheduled daily at 03:45)
#-----------------------------------------------------------------------------
# Filesystem disk (config/filesystems.php) the backup zips are written to.
# 'local' puts them under storage/app/private/<APP_NAME>/ on the same disk as
# the data; see readme.md "Backup and restore" for sending them elsewhere.
# The database dump needs mysqldump / mariadb-dump installed (mariadb-client).
BACKUP_DISK=local

#-----------------------------------------------------------------------------
# Logging Configuration
#-----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

#-----------------------------------------------------------------------------
# Mail Configuration
#-----------------------------------------------------------------------------
# Default transport is Resend (https://resend.com). Create an API key under
# your verified domain and set RESEND_KEY. MAIL_FROM_ADDRESS must be on the
# verified domain or Resend will reject the send.
MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS=novarr@novarr.atomicinsights.com.au
MAIL_FROM_NAME="${APP_NAME}"

# Optional SMTP fallback (used by the "failover" mailer). For Gmail:
# MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls,
# MAIL_USERNAME=<your-gmail>, MAIL_PASSWORD=<app-password>
# (App passwords: https://myaccount.google.com/apppasswords)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_EHLO_DOMAIN=

#-----------------------------------------------------------------------------
# Send to Kindle
#-----------------------------------------------------------------------------
# Your Kindle email (e.g. yourname_xxx@kindle.com). The MAIL_FROM_ADDRESS
# above must be approved in your Amazon "Approved Personal Document E-mail
# List" or delivery will be silently dropped.
KINDLE_EMAIL=
MAIL_SUMMARY_EMAIL=  # Recipient for the daily new-chapters summary

#-----------------------------------------------------------------------------
# Broadcasting Configuration
#-----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
# Pusher Configuration (uncomment if using Pusher)
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1

# Laravel Reverb Configuration (uncomment if using Reverb)
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=
# REVERB_PORT=443
# REVERB_SCHEME=https

#-----------------------------------------------------------------------------
# Vite Configuration
#-----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

#-----------------------------------------------------------------------------
# Additional Configuration
#-----------------------------------------------------------------------------
# Proxies whose X-Forwarded-For/-Host/-Port/-Proto headers are trusted
# (comma-separated IPs or CIDRs; "*" = whoever connects to nginx/php directly).
# Behind a Cloudflare Tunnel set it to the cloudflared connector's LAN address
# (127.0.0.1 if cloudflared runs on this machine; add 127.0.0.1 too if Tailscale
# Serve proxies to this box), e.g. TRUSTED_PROXIES=192.168.1.50,127.0.0.1 —
# then $request->ip() is the visitor and nobody else can forge it.
# CF-Connecting-IP is never read.
# TRUSTED_PROXIES=*

# Memcached Configuration (uncomment if using Memcached instead of Redis)
# MEMCACHED_HOST=127.0.0.1

# Hashing Configuration
# BCRYPT_ROUNDS=12
# ARGON_MEMORY=65536
# ARGON_THREADS=1
# ARGON_TIME=4

# Auth Configuration
# AUTH_PASSWORD_TIMEOUT=10800

# Require sign-in (reader accounts): on | off. Unset = Settings → Users decides
# (default off). When set it wins and locks that toggle. "on" stays off until the
# owner has a password (php artisan novarr:password). Escape hatch:
# php artisan novarr:auth on|off|status
# NOVARR_AUTH=

# Public address: hostnames Novarr is published on to the internet (e.g. through a
# Cloudflare Tunnel), comma-separated. On these hosts admin features are off (even
# for the admin), sign-in is required and followed by a second step (passkey,
# authenticator app, emailed code or recovery code: emailed codes need the mail
# settings above, not MAIL_MAILER=log), OPDS takes catalogue passwords only,
# cookies are Secure, HSTS + noindex are sent and credential attempts are capped
# per IP. Empty = off. No other settings: the second step needs none. APP_KEY
# encrypts authenticator secrets and keys recovery/emailed codes: changing it
# turns every authenticator app and recovery code off (admin: Reset second step). Invite and Android-app
# links use NOVARR_PUBLIC_URL (default https:// + the first host).
# NOVARR_PUBLIC_HOSTS=read.example.com
# LAN address(es) of the cloudflared connector: anything arriving straight from
# them is treated as public, even on a hostname missing from the list above.
NOVARR_PUBLIC_PROXIES=
# NOVARR_PUBLIC_URL=

# Human check (Cloudflare Turnstile) on the public address's sign-in and invite
# forms. Make a widget in the Cloudflare dashboard (Turnstile → Add widget, the
# public hostname as its domain) and paste its two keys. Both empty = off.
# Never asked on the home network, nor by the apps, OPDS or device pairing.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# New passwords are refused when they appear in a known data leak (Have I Been
# Pwned; only the first 5 characters of the password's SHA-1 are sent). If the
# service cannot be reached the password is allowed. off = no check.
NOVARR_PASSWORD_BREACH_CHECK=

# Days of sign-in history kept (Settings → Users → Sign-in history), and of the
# addresses recorded with each chapter read (Readers pages). 0 = forever.
NOVARR_AUTH_LOG_DAYS=

# Failure snapshots: pages the scraper fetched but could not read are kept
# gzipped under storage/app/snapshots for diagnosis (see /novels/{id}/snapshots).
NOVARR_SNAPSHOTS_ENABLED=true
NOVARR_SNAPSHOTS_KEEP=5
NOVARR_SNAPSHOTS_DAYS=14

# TLS verification for every scraper/FlareSolverr request (keep on; set to false only for a broken local mirror).
NOVARR_TLS_VERIFY=true

# Canonical host for the NovelPing (formerly novelarrow.com) source. Both hosts
# are recognised in stored URLs; API/chapter/cover URLs are built on this one.
NOVARR_NOVELARROW_HOST=novelping.com

# Suwayomi-Server: manga fetched through your own Suwayomi (its local API, no
# account). Empty URL = off. Languages and excluded source names (case-
# insensitive) decide which Suwayomi sources appear on Discover.
NOVARR_SUWAYOMI_URL=
NOVARR_SUWAYOMI_LANGUAGES=en
NOVARR_SUWAYOMI_EXCLUDE_SOURCES="MangaDex,Local source"
# NOVARR_SUWAYOMI_TIMEOUT=90

# Reader requests: the Requests page's "Discover manga" shelf (popular, new &
# popular and top-rated charts of the first manga source that offers them).
# Each page is cached this many minutes; page 1 is refreshed every three hours
# (requests:browse-warm). false = no shelf.
NOVARR_REQUESTS_BROWSE=true
# NOVARR_REQUESTS_BROWSE_CACHE_MINUTES=360

# Books (ePub uploads): readers upload, the owner matches and approves.
# Uploads up to this size (PHP's upload_max_filesize / post_max_size and
# nginx's client_max_body_size must allow it too).
# NOVARR_BOOKS_MAX_UPLOAD_MB=50
# Fill a book's description, genres and cover from Google Books and Open
# Library (the review page's matches); false = the ePub's own details only.
# NOVARR_BOOKS_LOOKUP=true
# Optional Google Books API key (works without one, at a lower daily quota).
# NOVARR_GOOGLE_BOOKS_KEY=
# The book catalogues asked (any of google, openlibrary, hardcover, itunes).
# Each one down is skipped. Hardcover needs a token (hardcover.app → Settings
# → API; with or without "Bearer "): series, ratings, and the Requests page's
# "Trending / Popular on Hardcover" shelves. Apple Books gives 1200 px covers.
# NOVARR_BOOK_SOURCES=google,openlibrary,hardcover,itunes
# NOVARR_HARDCOVER_TOKEN=
# NOVARR_ITUNES_COUNTRY=us
# Where uploaded originals are kept (back it up: it is the only copy).
# NOVARR_BOOKS_PATH=storage/app/books
# Originals of books imported from Calibre (Calibre keeps them too, so a
# folder outside storage/app keeps them out of the backups).
# NOVARR_BOOKS_CALIBRE_PATH=/mnt/big-disk/novarr-books

# AI covers (covers:generate, nightly; "Generate a cover" on a series page):
# a series without a real cover gets one painted on a local GPU. A local LLM
# (Ollama) writes a short visual brief from the description and the opening
# chapters, the cover painter (SDXL) paints it, Novarr sets the title and
# author on it. Off until both addresses are set. Never pushed to Calibre.
# NOVARR_COVERS_AI_OLLAMA_URL=http://192.168.1.96:11434
# NOVARR_COVERS_AI_BRIEF_MODEL=qwen3:8b
# NOVARR_COVERS_AI_PAINTER_URL=http://192.168.1.96:7861
# Paintings failed in a row that end a run; how often a busy GPU is asked again.
# NOVARR_COVERS_AI_MAX_FAILURES=3
# NOVARR_COVERS_AI_BUSY_RETRIES=6

# Audiobooks: drop an .m4b/.m4a/.mp3/.aac/.ogg/.opus/.flac file, or a folder
# of them, into the inbox; `audiobooks:scan` (every 10 minutes) moves each
# into the library once its copy has finished, and matches it to its book.
# What cannot be read goes to {inbox}/_failed with a .reason.txt.
# Needs ffprobe and ffmpeg (the ffmpeg package).
# NOVARR_AUDIOBOOKS_INBOX=storage/app/audiobooks-inbox
# NOVARR_AUDIOBOOKS_PATH=/mnt/big-disk/novarr-audiobooks
# NOVARR_FFPROBE=ffprobe
# NOVARR_FFMPEG=ffmpeg
# Seconds an entry must stay unchanged before it is imported (a copy may be running).
# NOVARR_AUDIOBOOKS_SETTLE_SECONDS=120
# What the files leave out (ASIN, narrator, description, series, cover,
# chapter names when the files have only "Part 1" / one per file) from the
# Audible catalogue + Audnexus, and a fallback cover from Apple Books; empty = off.
# Audible's store: us, uk, au, ca, de, fr, it, es, in, jp.
# NOVARR_AUDIOBOOK_SOURCES=audible,itunes
# NOVARR_AUDIBLE_REGION=us
# Readers upload audiobooks (chunked, resumable; the owner approves each) into
# {NOVARR_AUDIOBOOKS_PATH}/_uploads/. Limits are checked by the server; 8 MB
# chunks fit nginx's 50 MB and the Cloudflare tunnel's 100 MB request limits.
# Uploads over INLINE_MB are checked (SHA-256 + ffprobe) by a queued job.
# NOVARR_AUDIOBOOK_UPLOADS=true
# NOVARR_AUDIOBOOK_UPLOAD_MAX_FILE_MB=3072
# NOVARR_AUDIOBOOK_UPLOAD_MAX_TOTAL_MB=6144
# NOVARR_AUDIOBOOK_UPLOAD_MAX_FILES=200
# NOVARR_AUDIOBOOK_UPLOAD_MAX_PENDING=5
# NOVARR_AUDIOBOOK_UPLOAD_CHUNK_MB=8
# NOVARR_AUDIOBOOK_UPLOAD_MIN_FREE_GB=5
# NOVARR_AUDIOBOOK_UPLOAD_INLINE_MB=256
# NOVARR_AUDIOBOOK_UPLOAD_ABANDONED_HOURS=48

# Search Usenet & torrents (App\Downloads): Prowlarr is searched across all
# its indexers; usenet results go to NZBGet, torrents to Transmission, each
# finishing into the books / audiobooks inbox. Off unless the Prowlarr URL
# and API key are set; each download client is optional.
# NOVARR_PROWLARR_URL=http://prowlarr:9696
# NOVARR_PROWLARR_API_KEY=
# NOVARR_PROWLARR_TIMEOUT=60
# NOVARR_NZBGET_URL=http://nzbget:6789
# NOVARR_NZBGET_USERNAME=
# NOVARR_NZBGET_PASSWORD=
# NOVARR_NZBGET_CATEGORY_BOOKS=Novarr-Books
# NOVARR_NZBGET_CATEGORY_AUDIOBOOKS=Novarr-Audiobooks
# NOVARR_TRANSMISSION_URL=http://transmission:9091
# NOVARR_TRANSMISSION_USERNAME=
# NOVARR_TRANSMISSION_PASSWORD=
# The clients' own paths of the two inboxes (Transmission's download-dir).
# NOVARR_TRANSMISSION_DIR_BOOKS=/downloads/Novarr-Books
# NOVARR_TRANSMISSION_DIR_AUDIOBOOKS=/downloads/Audiobooks
# The books download inbox as Novarr sees it (the clients' Novarr-Books folder).
# NOVARR_BOOKS_INBOX=storage/app/books-inbox
# Automation (Sonarr/Radarr style): search the wanted list by itself, grab a
# confident match, add a matching ePub at once. The Downloads page's Settings
# overrides the switches, seeders, protocol and daily cap.
# NOVARR_DOWNLOADS_AUTO_SEARCH=true
# NOVARR_DOWNLOADS_AUTO_GRAB=true
# NOVARR_DOWNLOADS_AUTO_APPROVE=true
# NOVARR_DOWNLOADS_SEARCHES_PER_DAY=60
# NOVARR_DOWNLOADS_SEARCHES_PER_RUN=10
# NOVARR_DOWNLOADS_BACKOFF_HOURS=1,6,24,72
# NOVARR_DOWNLOADS_MIN_SCORE=80
# NOVARR_DOWNLOADS_PREFER_PROTOCOL=usenet
# NOVARR_DOWNLOADS_MIN_SEEDERS=2
# NOVARR_DOWNLOADS_MAX_AGE_DAYS=0
# NOVARR_DOWNLOADS_LANGUAGE=en
# NOVARR_DOWNLOADS_STALL_HOURS=6

# Calibre-Web (or Calibre-Web-Automated): its OPDS feed, read with a
# read-only account that may download. Empty URL = off.
NOVARR_CALIBRE_WEB_URL=
NOVARR_CALIBRE_WEB_USERNAME=
NOVARR_CALIBRE_WEB_PASSWORD=
# Calibre language codes to list and import (books with no language are
# included too); empty = every language.
# NOVARR_CALIBRE_WEB_LANGUAGES=eng
# Import books added to Calibre every hour (the first run only marks the
# starting point; `php artisan books:calibre-import --all` takes everything).
# NOVARR_CALIBRE_WEB_SYNC=true
